{
  "name": "@perrylink/dsh-research-suite",
  "version": "0.1.0",
  "description": "One-command research suite for DeepSeek Harness: installs the core evidence, verification, systematic-review and report plugins as one bundle layer, and adds a research_doctor health check for the REP store.",
  "author": "PerryLink contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-research-suite.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-research-suite#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-research-suite/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "research",
    "evidence",
    "reproducibility"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0"
  },
  "packageManager": "pnpm@12.16.1",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "dependencies": {
    "@perrylink/dsh-claim-check": "0.1.2",
    "@perrylink/dsh-research-core": "0.1.1",
    "dsh-cite-verify": "0.2.0",
    "dsh-doc-anchor": "0.1.1",
    "dsh-library": "0.2.26",
    "dsh-manuscript-check": "0.1.2",
    "dsh-meta-analysis": "0.1.2",
    "dsh-repro-audit": "0.1.3",
    "dsh-research-report": "0.3.32",
    "dsh-retraction-watch": "0.1.1",
    "dsh-sr-ledger": "0.1.2",
    "dsh-statcheck": "0.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
